{
    "dataset_name": "MSRVTT",
    "msrvtt_train_file": "9k",
    "videos_dir": "/path/to/MSRVTT/MSRVTT_Videos",
    "num_frames": 12,
    "video_sample_type": "uniform",
    "input_res": 224,
    
    "base_model": "clip4clip",
    "clip_arch": "ViT-B/32",
    "huggingface": true,
    "embed_dim": 512,
    "checkpoint_path": "/path/to/clip4clip_msrvtt.pth",
    "pooling_type": "avg",

    "tta_method": "mock",
    "tta_steps": 3,
    "con_ratio": 0.3,
    "temperature": 0.02,
    "t": 0.1,
    "retrieval_type": "t2v",
    "noised_text_dir": "/path/to/MSRVTT/noised_texts",

    "seed": 42,
    "init_lr": 3e-4,
    "weight_decay": 1e-4,
    "num_workers": 8,
    "batch_size": 16,
    "loss_window_size": 6,
    "loss_log_every": 3,
    "loss_dump": false,

    "use_preprocessed": true,
    "preprocess_dir": "/path/to/MSRVTT/preprocess_videos"
}